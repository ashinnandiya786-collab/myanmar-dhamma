    score = 0
    
    for i, q in enumerate(questions):
        print(f"\n{q['question']}")
        user_ans = input("ဖြေဆိုရန် (အဖြေကို တိုက်ရိုက်ရိုက်ထည့်ပါ) - ").strip()
        
        if user_ans == q["answer"]:
            print("✨ ဂုဏ်ယူပါတယ်၊ အဖြေမှန်ပါသည်။")
            score += 1
        else:
            print(f"❌ အဖြေမှားပါသည်။ မှန်ကန်သော အဖြေမှာ '{q['answer']}' ဖြစ်ပါသည်။")
            
    print(f"\n🏁 ဂိမ်းပြီးဆုံးပါပြီ သားကြီး! ရရှိသော ရမှတ် - {score} / {len(questions)}")

